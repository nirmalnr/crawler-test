    "schema": {
      "type": "object",
      "title": " Public Data Set Schema",
      "$schema": "http://json-schema.org/draft-07/schema#",
      "required": [
        "publisher_id",
        "name",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Human-readable name of the dataset"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Data kind and domain tags for discoverability (e.g. policy, tariff, program, prosumer, grid, billing)"
        },
        "type": {
          "enum": [
            "csv",
            "json",
            "xml",
            "geojson",
            "parquet",
            "pdf",
            "image",
            "binary",
            "other"
          ],
          "type": "string",
          "description": "Format of the dataset"
        },
        "data_url": {
          "type": "string",
          "format": "uri",
          "description": "URL where the dataset is hosted"
        },
        "data_inline": {
          "type": "string",
          "description": "The dataset itself, embedded inline as a string (base64-encoded for binary formats, raw text for CSV/JSON/XML)"
        },
        "description": {
          "type": "string",
          "description": "What this dataset contains and its intended use"
        },
        "publisher_id": {
          "type": "string",
          "description": "Identifier of the publishing entity"
        },
        "data_url_checksum": {
          "type": "string",
          "description": "Hash value of the data at data_url"
        },
        "data_url_checksum_type": {
          "enum": [
            "sha256",
            "sha384",
            "sha512",
            "md5",
            "sha1"
          ],
          "type": "string",
          "description": "Algorithm used to compute data_url_checksum"
        }
      },
      "description": "Schema for publishing public datasets on DeDi. Supports both inline data and external data referenced by URL with integrity verification via checksum."
    },
