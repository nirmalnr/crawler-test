  "registry": {
    "name": "beckn_subscriber",
    "schema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Beckn Subscriber",
      "description": "A registry entry describing endpoints and keys of a beckn network participant.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subscriber_id": {
          "type": "string",
          "description": "Globally unique identifier of the platform, typically an FQDN."
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Specifies the callback URL of the subscriber."
        },
        "type": {
          "type": "string",
          "description": "Type of role played in the network (Beckn Application Provider, Beckn Platform Provider, Catalogue Service, Discovery Service)",
          "enum": [
            "BAP",
            "BPP",
            "CS",
            "DS",
            "CDS"
          ]
        },
        "domain": {
          "type": "string",
          "description": "Operating industry domain that this subscriber offers its products or services in. A single subscriber can operate in multiple domains and each can be added as a separate record. This field is deprecated and will be removed from the registry."
        },
        "countries": {
          "type": "array",
          "description": "Countries where the subscriber operates, provides services, or conducts business.",
          "items": {
            "type": "string",
            "description": "ISO 3166-1 alpha-3 country code.",
            "enum": [
              "IND",
              "USA",
              "GBR",
              "ARE",
              "SGP"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "signing_public_key": {
          "type": "string",
          "description": "Signing public key of the subscriber."
        },
        "encr_public_key": {
          "type": "string",
          "description": "Encryption public key of the subscriber."
        }
      },
      "required": [
        "subscriber_id",
        "url",
        "type",
        "countries",
        "signing_public_key"
      ]
    },
    "state": "live",
    "updated_at": "2026-08-11T00:00:00Z"
